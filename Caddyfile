# Caddy — รับคำขอจากภายนอกแล้วส่งต่อเข้า frontend
#
# มีไว้เพื่อใบรับรอง HTTPS เป็นหลัก Caddy ขอใบรับรองจาก Let's Encrypt เองและต่ออายุ
# ให้อัตโนมัติก่อนหมดอายุ ไม่ต้องมีใครมาคอยต่อ
#
# ทำไมต้องมีบล็อกที่ไม่ระบุชื่อโดเมนด้วย
# ------------------------------------
# ระบบเปิดให้เข้าทางเลข IP มาตลอด และเอกสารหลายที่ยังอ้างเลข IP อยู่ ถ้าเหลือแต่บล็อก
# ที่ผูกกับชื่อโดเมน การเข้าทาง IP จะพังทันทีในวันที่สลับมาใช้ Caddy บล็อก :80 จึงรับ
# คำขอที่ไม่ตรงกับชื่อโดเมนใดเลยไว้ ให้ทั้งสองทางใช้งานได้พร้อมกัน
#
# การเข้าทาง IP จะไม่มีกุญแจล็อกเสมอ เพราะออกใบรับรองให้เลข IP ไม่ได้ — ต้องใช้ชื่อ
# โดเมนเท่านั้น

{
	# อีเมลสำหรับ Let's Encrypt ใช้แจ้งเตือนถ้าการต่ออายุมีปัญหา
	# ตั้งผ่านตัวแปร ACME_EMAIL ใน .env
	email {$ACME_EMAIL}
}

# ชื่อโดเมนจริง — ตั้งผ่านตัวแปร SITE_DOMAIN ใน .env
# Caddy จะขอใบรับรองให้ชื่อนี้เองในการเรียกครั้งแรก และเปลี่ยนเส้นทาง http เป็น https ให้
{$SITE_DOMAIN} {
	reverse_proxy frontend:3000
}

# ทางเข้าด้วยเลข IP หรือชื่ออื่นที่ชี้มาที่เครื่องนี้ — http ล้วน ไม่มีใบรับรอง
:80 {
	reverse_proxy frontend:3000
}
