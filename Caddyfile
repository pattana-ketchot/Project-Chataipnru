# Caddy — รับคำขอจากภายนอกแล้วกระจายไปยังส่วนที่ถูกต้อง
#
# แบ่งเป็นสองทางเข้าโดยตั้งใจ
# ---------------------------
#   ทางชื่อโดเมน   หน้าเว็บจริงที่ทีมออกแบบทำ (ไฟล์นิ่งใน web/) + API
#   ทางเลข IP      หน้าเว็บเดิมของหลังบ้าน ใช้ทดสอบด้วยมือที่ /match กับ /compare
#
# แยกกันเพราะสองหน้าใช้คนละเฟรมเวิร์กและคนละทีมดูแล การยัดรวมกันที่เดียวทำให้ต้อง
# เลือกทิ้งอย่างใดอย่างหนึ่ง ทั้งที่ยังใช้ทั้งคู่อยู่จริง
#
# ไม่ระบุอีเมลสำหรับ Let's Encrypt ไว้ที่นี่โดยตั้งใจ — เคยเขียนเป็น email {$ACME_EMAIL}
# แล้วเว็บล่มทั้งเว็บ เพราะตัวแปรไม่ได้ตั้งไว้บนเซิร์ฟเวอร์ บรรทัดจึงเหลือคำว่า email
# ลอยๆ ซึ่งผิดไวยากรณ์ Caddy ไม่ยอมเริ่มทำงานและไม่มีอะไรรับคำขอที่พอร์ต 80 อีกเลย
# ถ้าต้องการ เพิ่ม { email you@example.com } ไว้บนสุดโดยใส่อีเมลจริงลงไปตรงๆ

{$SITE_DOMAIN} {
	# หน้าเว็บเรียก /api/chat โดยส่งประวัติทั้งก้อนมาและรอข้อความดิบกลับไป ซึ่งเป็น
	# คนละสัญญากับ /chat เดิมของหลังบ้านที่ชุดประเมินและเอกสารนักพัฒนาใช้อยู่
	# จึงชี้ไปที่ /chat-web ที่รับรูปแบบของหน้าเว็บโดยเฉพาะ
	handle /api/chat {
		rewrite * /chat-web
		reverse_proxy backend:8000
	}

	# เส้นทาง API ที่เหลือชื่อตรงกับหลังบ้านอยู่แล้ว ตัดคำนำหน้า /api ออกก็พอ
	# ครอบคลุม /api/compare-courses, /api/recommend-major, /api/courses, /api/docs
	handle /api/* {
		uri strip_prefix /api
		reverse_proxy backend:8000
	}

	# ไฟล์ใน assets/ มีรหัสของเนื้อหาอยู่ในชื่อไฟล์ (index-BrQ05Vjo.js) เนื้อหาเปลี่ยน
	# เมื่อไหร่ชื่อไฟล์เปลี่ยนตาม จึงให้เบราว์เซอร์เก็บไว้ได้ยาวๆ อย่างปลอดภัย
	handle /assets/* {
		root * /srv/web
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# ที่เหลือเป็นหน้าเว็บ เป็นแอปหน้าเดียวที่จัดการเส้นทางเองในเบราว์เซอร์ ทุก path
	# ที่ไม่ใช่ไฟล์จริงจึงต้องคืน index.html ไม่งั้นการกดรีเฟรชระหว่างอยู่หน้าอื่นจะได้ 404
	#
	# index.html ต้องถามเซิร์ฟเวอร์ทุกครั้งว่ามีของใหม่ไหม เพราะชื่อไฟล์ไม่เปลี่ยนตาม
	# เนื้อหา มันคือไฟล์ที่บอกว่าต้องโหลด assets ตัวไหน ถ้าเบราว์เซอร์เก็บของเก่าไว้
	# ผู้ใช้จะเห็นเว็บเวอร์ชันเก่าต่อไปเรื่อยๆ แม้ deploy ใหม่แล้ว — เดิมไม่ได้ส่ง
	# Cache-Control มาเลย เบราว์เซอร์จึงเดาเอาเองว่าเก็บไว้ได้ และเก็บไว้จริง
	handle {
		root * /srv/web
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

# ทางเข้าด้วยเลข IP — หน้าเว็บเดิมของหลังบ้าน ไม่มีใบรับรองเพราะออกให้เลข IP ไม่ได้
:80 {
	reverse_proxy frontend:3000
}
