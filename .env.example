# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง — ห้าม commit .env ตัวจริงเข้า git
# SECURITY: ใช้ secret ที่สุ่มยาวพอ เช่น `openssl rand -hex 32`
#
# ไฟล์เดียวนี้ถูกอ่านโดย 3 ฝั่ง: docker compose, backend (pydantic-settings)
# และ pipeline (python-dotenv)

# =====================================================================
# รหัสผ่าน PostgreSQL — docker compose ใช้ตอนสร้าง container/role ครั้งแรก
# สำคัญ: role ถูกสร้างครั้งเดียวตอน volume ว่าง ถ้าแก้รหัสผ่านตรงนี้ทีหลัง
# ต้อง ALTER ROLE ใน DB เองด้วย ไม่งั้นค่าจะไม่ตรงกัน
# =====================================================================
POSTGRES_PASSWORD=change-me-local-only
ADVISOR_API_PASSWORD=change-me-api
ADVISOR_INGEST_PASSWORD=change-me-ingest

# =====================================================================
# Connection string — รหัสผ่านต้องตรงกับ 3 ตัวข้างบน
#
# ใช้ 127.0.0.1 ห้ามใช้ localhost: บน Windows ชื่อ localhost ถูก resolve เป็น
# IPv6 (::1) ก่อน แต่ Docker bind พอร์ตไว้ที่ IPv4 เท่านั้น ทุก connection จะรอ
# timeout ~5 วินาทีก่อน fallback มา IPv4 ทำให้ระบบอืดผิดปกติโดยไม่มี error ให้เห็น
# =====================================================================
# Backend ใช้ SQLAlchemy -> ต้องมี dialect prefix `+psycopg`
DATABASE_URL=postgresql+psycopg://advisor_api:change-me-api@127.0.0.1:5432/course_advisor

# Pipeline ใช้ psycopg ตรงๆ -> ห้ามใส่ `+psycopg`
# role `advisor_ingest` มีสิทธิ์เฉพาะ courses/course_documents/course_chunks (ดู db/20-roles.sh)
INGEST_DATABASE_URL=postgresql://advisor_ingest:change-me-ingest@127.0.0.1:5432/course_advisor

# =====================================================================
# Backend
# =====================================================================
JWT_SECRET=change-me-to-a-random-64-char-hex-string

OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen2.5:7b
EMBED_MODEL=bge-m3
EMBED_DIM=1024

PDF_STORAGE_DIR=./storage/pdfs
CORS_ALLOW_ORIGINS=["http://localhost:3000"]
