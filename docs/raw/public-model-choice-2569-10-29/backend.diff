+        if c["provider"] == "ollama" and not public_local_enabled():
+            continue
+        out.append({
+            "id": c["id"],
+            "label": c["label"],
+            "hint": c["hint"],
+            "model": c["model"] or default_model_of(c["provider"]),
+            "default": c["id"] == DEFAULT_PUBLIC_CHOICE,
+            # เพดานเวลาของตัวเลือกนั้น — หน้าเว็บใช้ตั้งความคาดหวังของคนรอ
