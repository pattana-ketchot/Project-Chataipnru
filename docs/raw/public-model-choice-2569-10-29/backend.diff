+    def test_ข้ออ้างมี_X_ที่ยาวและหลักฐานไม่รองรับ_ต้องไม่ผ่าน(self):
+        """
+        คู่ที่สอง — ข้ออ้างที่เอกสารไม่ได้เขียนไว้ต้องถูกรายงานว่ายืนยันไม่ได้
+
+        ก่อนรอบ 18 ข้ออ้างยาวแบบนี้ถูกข้ามทั้งข้อ (เพดาน 30 ตัวอักษรตัดกลางคำ แล้ว
+        โค้ดทิ้งข้ออ้างที่ถูกตัด) คำตอบที่อ้างกลุ่มวิชาที่ไม่มีในเอกสารจึงไม่เหลือข้ออ้าง
+        ให้ตรวจเลย และถูกรายงานว่า "ไม่มีข้ออ้างที่ตรวจได้" หรือ "รองรับครบ" ตามข้ออื่น
+        ในคำตอบ · การไม่ตรวจต้องไม่ถูกรายงานเป็นการผ่าน
+        """
+        answer = "หลักสูตรนี้มีกลุ่มวิชาวิศวกรรมอากาศยานและเทคโนโลยีอวกาศ"
+        v = verify(answer, EV_GROUP)
+        self.assertIn("มีกลุ่มวิชาวิศวกรรมอากาศยานและเทคโนโลยีอวกาศ",
+                      [c.shown for c in v.checked], [c.shown for c in v.checked])
+        self.assertEqual(v.status, "ยืนยันไม่ได้", [c.shown for c in v.checked])
+
+    def test_ข้ออ้างไม่มี_X_ที่ยาว_ต้องถูกตรวจเต็มข้อทั้งสองทาง(self):
+        """ข้ออ้างเชิงปฏิเสธที่ยาวก็ต้องไม่หาย — หายไปคือยืนยันการไม่มีโดยไม่ตรวจ"""
+        answer = "หลักสูตรนี้ไม่มีกลุ่มวิชาเทคโนโลยีสารสนเทศและการสื่อสาร"
+        v = verify(answer, EV_GROUP)
+        self.assertIn("ไม่มีกลุ่มวิชาเทคโนโลยีสารสนเทศและการสื่อสาร",
+                      [c.shown for c in v.unsupported], [c.shown for c in v.checked])
+        self.assertEqual(v.status, "ยืนยันไม่ได้", [c.shown for c in v.checked])
+        # คู่ควบคุม — เมื่อเอกสารเขียนปฏิเสธเรื่องนั้นไว้จริง ข้ออ้างยาวข้อเดียวกันต้องยืนยันได้
+        ev_negated = ["หลักสูตรนี้ไม่ได้กำหนดกลุ่มวิชาเทคโนโลยีสารสนเทศและการสื่อสารไว้ใน"
+                      "หมวดวิชาเฉพาะ · หลักสูตรวิทยาศาสตรบัณฑิต สาขาวิชาเทคโนโลยีสารสนเทศ (พ.ศ. 2566)"]
+        self.assertEqual(verify(answer, ev_negated).status, "รองรับครบ",
+                         [c.shown for c in verify(answer, ev_negated).unsupported])
+
 
 if __name__ == "__main__":
     unittest.main(verbosity=2)
