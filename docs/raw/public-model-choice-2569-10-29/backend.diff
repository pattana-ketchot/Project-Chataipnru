+    เช่นเซิร์ฟเวอร์ที่ไม่ได้ตั้ง GEMINI_API_KEY จะไม่เห็นตัวเลือกของ Gemini เลย
+    """
+    out = []
+    for c in PUBLIC_CHOICES:
+        if c["provider"] == "gemini" and not has_gemini_key():
