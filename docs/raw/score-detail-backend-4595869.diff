+class AnswerDisclosureTests(_ScoreDetailBase):
+    def test_ส่งเฉพาะคำตอบที่เข้าไปคิดคะแนนจริง(self):
+        used = _answer_rows(ANSWERS, _SCORED_FIELDS)
