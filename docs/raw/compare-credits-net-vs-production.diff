+    จริงระหว่างฉบับ (คณิตศาสตร์ 2564 = 130 · 2569 = 124)
+
+    ใช้ _credit_phrase เดิมเพื่อให้คำว่า "ไม่น้อยกว่า" ขึ้นเฉพาะเมื่อเอกสารเขียนไว้จริง
+    """
+    if not ids:
+        return {}
+    facts, _ = _scalar_facts(db, "total_credits", ids, {})
